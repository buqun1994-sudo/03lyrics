<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/commercial_summary_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/commercial_summary_height"
    android:paddingStart="@dimen/settings_content_padding_start"
    android:paddingTop="@dimen/commercial_summary_margin_top"
    android:paddingEnd="@dimen/settings_content_padding_end"
    android:paddingBottom="@dimen/commercial_summary_margin_bottom">

    <LinearLayout
        android:id="@+id/commercial_summary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/commercial_summary_banner_height"
        android:background="@drawable/bg_settings_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/commercial_summary_status"
            style="@style/SettingsText.Body2.Emphasis"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:text="@string/commercial_checking" />

        <LinearLayout
            android:id="@+id/commercial_summary_offer_group"
            android:layout_width="@dimen/commercial_summary_offer_width"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/commercial_summary_offer_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsText.Body2.Emphasis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/commercial_offer_title" />

                <TextView
                    android:id="@+id/commercial_summary_discount"
                    style="@style/SettingsText.Caption2.Emphasis"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_commercial_corner_badge"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/commercial_summary_offer_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/commercial_summary_original_price"
                    style="@style/SettingsText.Caption2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/commercial_summary_final_price"
                    style="@style/SettingsText.CommercialOrderPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/commercial_summary_chevron"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_commercial_chevron_right" />
    </LinearLayout>
</FrameLayout>
