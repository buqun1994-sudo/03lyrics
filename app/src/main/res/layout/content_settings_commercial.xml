<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_commercial_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/commercial_page_min_height"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/commercial_entitlement_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/commercial_page_horizontal_padding"
        android:paddingEnd="@dimen/commercial_page_horizontal_padding">

        <LinearLayout
            android:id="@+id/commercial_entitlement_status_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="@dimen/commercial_page_edge_margin"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/commercial_entitlement_title"
                style="@style/SettingsText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/commercial_checking" />

            <TextView
                android:id="@+id/commercial_large_status"
                style="@style/SettingsText.Body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAlignment="center"
                android:text="@string/commercial_trial_remaining" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commercial_large_price_area"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:translationY="@dimen/commercial_marketing_vertical_offset"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/commercial_marketing_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/commercial_marketing_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsText.CommercialOfferTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/commercial_offer_title" />

                    <TextView
                        android:id="@+id/commercial_marketing_discount"
                        style="@style/SettingsText.Caption2.Emphasis"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="18dp"
                        android:background="@drawable/bg_commercial_corner_badge"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/commercial_marketing_price_comparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="24dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsText.Caption2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/commercial_offer_original_price_label" />

                        <TextView
                            android:id="@+id/commercial_marketing_original_price"
                            style="@style/SettingsText.Body2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxLines="1"
                            android:textColor="@color/settings_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsText.Caption2.Emphasis"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/commercial_offer_price_label" />

                        <TextView
                            android:id="@+id/commercial_marketing_final_price"
                            style="@style/SettingsText.CommercialPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commercial_pro_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/commercial_pro_crown"
                android:layout_width="@dimen/commercial_pro_icon_size"
                android:layout_height="@dimen/commercial_pro_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_commercial_pro_crown" />

            <TextView
                android:id="@+id/commercial_pro_state_title"
                style="@style/SettingsText.CommercialOfferTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/commercial_pro_title_spacing"
                android:gravity="center"
                android:text="@string/commercial_pro_title" />

            <TextView
                android:id="@+id/commercial_pro_state_status"
                style="@style/SettingsText.Body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/commercial_pro_status_spacing"
                android:gravity="center"
                android:text="@string/commercial_pro_active" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/commercial_entitlement_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/commercial_page_edge_margin"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/commercial_large_checkout_action"
                style="@style/SettingsText.Body2.Emphasis"
                android:layout_width="@dimen/commercial_primary_action_width"
                android:layout_height="@dimen/commercial_primary_action_height"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_commercial_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/commercial_checkout"
                android:textColor="@color/commercial_action_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/commercial_restore_action"
                style="@style/SettingsText.Caption2"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/commercial_restore_purchase" />

            <TextView
                android:id="@+id/commercial_restore_status"
                style="@style/SettingsText.Caption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/commercial_order_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/commercial_page_min_height"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_content_padding_start"
            android:paddingTop="@dimen/commercial_page_edge_margin"
            android:paddingEnd="@dimen/settings_content_padding_end">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/commercial_back_size"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/commercial_order_back"
                android:layout_width="@dimen/commercial_back_size"
                android:layout_height="@dimen/commercial_back_size"
                android:clickable="true"
                android:contentDescription="@string/commercial_order_back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_commercial_back" />

            <TextView
                style="@style/SettingsText.Body1.Emphasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/commercial_order_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/commercial_order_content_padding_horizontal"
            android:paddingEnd="@dimen/commercial_order_content_padding_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsText.Caption2"
                    android:layout_width="@dimen/commercial_order_label_width"
                    android:layout_height="wrap_content"
                    android:text="@string/commercial_order_product" />

                <TextView
                    android:id="@+id/commercial_order_product_value"
                    style="@style/SettingsText.Body2.Emphasis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textAlignment="viewEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsText.Caption2"
                    android:layout_width="@dimen/commercial_order_label_width"
                    android:layout_height="wrap_content"
                    android:text="@string/commercial_order_original_price" />

                <TextView
                    android:id="@+id/commercial_order_original_price_value"
                    style="@style/SettingsText.Body2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAlignment="viewEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/commercial_input_height"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsText.Caption2"
                    android:layout_width="@dimen/commercial_order_label_width"
                    android:layout_height="wrap_content"
                    android:text="@string/commercial_order_discount_code" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/commercial_discount_input"
                        android:layout_width="@dimen/commercial_order_input_width"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_commercial_input"
                        android:hint="@string/commercial_discount_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textColor="@color/settings_text_primary"
                        android:textColorHint="@color/settings_text_secondary"
                        android:textSize="@dimen/settings_text_caption2" />

                    <TextView
                        android:id="@+id/commercial_apply_discount"
                        style="@style/SettingsText.Caption2.Emphasis"
                        android:layout_width="@dimen/commercial_order_apply_width"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/commercial_row_spacing"
                        android:background="@drawable/bg_commercial_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/commercial_apply_discount" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/commercial_discount_message"
                style="@style/SettingsText.Caption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/commercial_order_label_width"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:textColor="@color/commercial_error"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsText.Caption2"
                    android:layout_width="@dimen/commercial_order_label_width"
                    android:layout_height="wrap_content"
                    android:text="@string/commercial_order_discount" />

                <TextView
                    android:id="@+id/commercial_order_discount_value"
                    style="@style/SettingsText.Caption2.Emphasis"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAlignment="viewEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SettingsText.Caption2"
                    android:layout_width="@dimen/commercial_order_label_width"
                    android:layout_height="wrap_content"
                    android:text="@string/commercial_order_final_price" />

                <TextView
                    android:id="@+id/commercial_order_final_price_value"
                    style="@style/SettingsText.CommercialOrderPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAlignment="viewEnd" />
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/commercial_page_edge_margin"
            android:orientation="vertical"
            android:paddingStart="@dimen/commercial_order_total_padding_horizontal"
            android:paddingEnd="@dimen/commercial_order_total_padding_horizontal">

            <TextView
                style="@style/SettingsText.Caption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commercial_payment_method" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/commercial_payment_segment_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_segment_track"
                android:orientation="horizontal"
                android:padding="@dimen/settings_segment_padding">

                <TextView
                    android:id="@+id/commercial_payment_wechat"
                    style="@style/SettingsText.Option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/commercial_payment_wechat" />

                <TextView
                    android:id="@+id/commercial_payment_alipay"
                    style="@style/SettingsText.Option"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/commercial_payment_alipay" />
            </LinearLayout>

            <TextView
                android:id="@+id/commercial_order_message"
                style="@style/SettingsText.Caption2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/commercial_pay_action"
                style="@style/SettingsText.Body2.Emphasis"
                android:layout_width="@dimen/commercial_primary_action_width"
                android:layout_height="@dimen/commercial_primary_action_height"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_commercial_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/commercial_pay"
                android:textColor="@color/commercial_action_text" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/commercial_qr_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/commercial_page_horizontal_padding"
        android:paddingEnd="@dimen/commercial_page_horizontal_padding"
        android:visibility="gone">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            style="@style/SettingsText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commercial_qr_title" />

        <FrameLayout
            android:layout_width="@dimen/commercial_qr_size"
            android:layout_height="@dimen/commercial_qr_size"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_commercial_qr">

            <ImageView
                android:id="@+id/commercial_qr_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/commercial_qr_placeholder"
                style="@style/SettingsText.Caption2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/commercial_qr_placeholder"
                android:textColor="@color/commercial_expired_text" />
        </FrameLayout>

        <TextView
            android:id="@+id/commercial_payment_amount"
            style="@style/SettingsText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/commercial_order_expiry"
            style="@style/SettingsText.Caption2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/commercial_payment_status"
            style="@style/SettingsText.Body2.Emphasis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/commercial_payment_pending" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
